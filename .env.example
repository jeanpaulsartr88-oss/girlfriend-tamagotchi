# ================================================================
# НАСТРОЙКИ TELEGRAM БОТА И ОПОВЕЩЕНИЙ
# ================================================================

# Токен бота, полученный у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Chat ID парня (куда присылать чекины любимой)
# Узнать свой ID можно через бота @userinfobot в Telegram
TELEGRAM_CHAT_ID=123456789

# Публичный URL приложения (например, https://tamagotchi-girl.onrender.com)
# При деплое на Render.com переменная RENDER_EXTERNAL_URL подхватится автоматически!
WEBHOOK_URL=https://your-app-name.onrender.com

# Для локальной разработки и тестирования бота без ngrok поставьте true:
USE_POLLING=false

# База данных (по умолчанию SQLite)
DATABASE_URL=sqlite:///./tamagotchi.db
